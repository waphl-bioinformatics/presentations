    "chart-1": {
      "controls": true,
      "interpolate": "linear",
      "seriesStacking": "stacked",
      "xAxisLabelLimit": 120,
      "yAxisLabelLimit": 30,
      "title": "Progressive Core Genome Fraction",
      "paneId": "chart-1",
      "type": "custom",
      "spec": "{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"autosize\": {\n    \"type\": \"fit-x\",\n    \"resize\": true,\n    \"contains\": \"padding\"\n  },\n  \"width\": \"container\",\n  \"height\": 300,\n  \"config\": {\n    \"axis\": {\n      \"labelFontSize\": 12,\n      \"titleFontSize\": 14,\n      \"titlePadding\": 10,\n      \"grid\": true,\n      \"gridColor\": \"#e0e0e0\",\n      \"gridOpacity\": 0.5,\n      \"domain\": false,\n      \"tickColor\": \"#666666\"\n    },\n    \"legend\": {\n      \"labelFontSize\": 12,\n      \"titleFontSize\": 14,\n      \"symbolSize\": 100\n    },\n    \"header\": {\n      \"labelFontSize\": 12,\n      \"titleFontSize\": 14\n    },\n    \"title\": {\n      \"fontSize\": 16,\n      \"fontWeight\": \"bold\",\n      \"anchor\": \"start\",\n      \"offset\": 10\n    },\n    \"view\": {\n      \"stroke\": \"transparent\"\n    },\n    \"background\": \"#fafafa\"\n  },\n  \"data\": {\n    \"name\": \"table\"\n  },\n  \"transform\": [\n    {\n      \"calculate\": \"toNumber(datum.core_fraction)\",\n      \"as\": \"core_fraction_num\"\n    },\n    {\n      \"calculate\": \"toNumber(datum.genome_fraction)\",\n      \"as\": \"genome_fraction_num\"\n    },\n    {\n      \"window\": [\n        {\n          \"op\": \"row_number\",\n          \"as\": \"order\"\n        }\n      ],\n      \"sort\": [\n        {\n          \"field\": \"genome_fraction_num\",\n          \"order\": \"descending\"\n        }\n      ]\n    }\n  ],\n  \"mark\": {\n    \"type\": \"line\",\n    \"point\": {\n      \"size\": 80,\n      \"filled\": true,\n      \"strokeWidth\": 1.5,\n      \"stroke\": \"white\"\n    },\n    \"strokeWidth\": 2.5,\n    \"color\": \"#2E86AB\",\n    \"interpolate\": \"monotone\"\n  },\n  \"encoding\": {\n    \"x\": {\n      \"field\": \"id\",\n      \"type\": \"nominal\",\n      \"sort\": {\n        \"field\": \"genome_fraction_num\",\n        \"op\": \"mean\",\n        \"order\": \"descending\"\n      },\n      \"axis\": {\n        \"title\": \"Sample (ordered by genome fraction)\",\n        \"labelAngle\": -45,\n        \"labelAlign\": \"right\",\n        \"labelBaseline\": \"top\",\n        \"labelPadding\": 5,\n        \"titlePadding\": 15\n      }\n    },\n    \"y\": {\n      \"field\": \"core_fraction_num\",\n      \"type\": \"quantitative\",\n      \"scale\": {\n        \"zero\": false,\n        \"nice\": true\n      },\n      \"axis\": {\n        \"title\": \"Core fraction\"\n      }\n    },\n    \"order\": {\n      \"field\": \"order\",\n      \"type\": \"ordinal\"\n    },\n    \"tooltip\": [\n      {\n        \"field\": \"id\",\n        \"type\": \"nominal\",\n        \"title\": \"Sample\"\n      },\n      {\n        \"field\": \"core_fraction_num\",\n        \"type\": \"quantitative\",\n        \"title\": \"Core fraction\",\n        \"format\": \".3f\"\n      },\n      {\n        \"field\": \"genome_fraction_num\",\n        \"type\": \"quantitative\",\n        \"title\": \"Genome fraction\",\n        \"format\": \".3f\"\n      }\n    ]\n  }\n}"
    }
